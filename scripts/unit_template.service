# Generated by scripts/gen_unit.py from scripts/unit_template.service and the service's systemd.conf (if it has one).
# Don't edit: change those, then run `make update_units` in the ZMW root.
[Unit]
Description=@NAME@
After=mqtt_baticasa.service
Wants=mqtt_baticasa.service

[Service]
# Dirs the sandbox binds must exist before it's set up: + runs these outside of it (as root, hence -o/-g)
ExecStartPre=+/usr/bin/install -d -o @USER@ -g @USER@ -m 740 "@RUN@"
ExecStartPre=+/usr/bin/install -d -o @USER@ -g @USER@ -m 700 "@SVC_TMP@"
Environment=
# Libraries cache things in ~ (onnxruntime, huggingface, Intel's GPU kernel cache): keep that in the run dir, which
# is all the service can write once sandboxed
Environment=HOME=@RUN@
Environment=XDG_CACHE_HOME=@RUN@/.cache
ExecStart=@EXEC_START@
WorkingDirectory=@RUN@
Restart=always
RestartSec=10s
# Services exit within ~5s of SIGTERM (service_runner); past this they're killed. Also caps a stop while starting up,
# if a SIGTERM ever gets lost
TimeoutStopSec=10s
User=@USER@

# Hardening that needs no per-service exceptions
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
# Files passed between services go through the shared scratch dir (@SVC_TMP@), so /tmp can be private (the host's
# has a tmux socket)
PrivateTmp=yes
# Private run dirs: /home is an empty tmpfs, with the service's own source and the source tree libs its venv uses
# (read only), its run dir and the shared scratch dir (read write) bound in. Anything else (eg ~/nvrish) is bound by
# its systemd.conf, from the paths in its config.json. The rest of the file system is read only
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=@SRC@ @SRC_LIBS@
BindPaths=@RUN@ @SVC_TMP@
# Own PID namespace: other services' processes aren't visible, so no reading their /proc/<pid>/root or cwd (they all
# run as @USER@), and no signalling them. The service is its namespace's PID 1 (service_runner handles SIGTERM)
PrivatePIDs=yes
# @USER@ is in the docker group (docker.sock = root), and the user session bus can start unsandboxed processes
InaccessiblePaths=-/run/docker.sock -/run/containerd -/run/user
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectProc=invisible
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
# No devices beyond /dev/null and co (a service that needs one adds it in its systemd.conf, eg visitor_detect's GPU)
PrivateDevices=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Audit mode: syscalls outside the usual set for services are logged (kernel log, audit type=1326), not blocked. Once
# that's quiet, replace with SystemCallFilter=@system-service (see HARDENING_TODO.md)
SystemCallLog=~@system-service

[Install]
WantedBy=multi-user.target
